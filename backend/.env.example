# Hunar Backend - Environment
# Copy this file to .env and fill values

# Server
PORT=4000
NODE_ENV=development

# MySQL (free-tier compatible, e.g. Clever Cloud Dev plan or local XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hunar

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# OTP (dev mode prints OTP to console; integrate SMS gateway in production)
OTP_SECRET=change-this-otp-pepper
OTP_EXPIRY_MINUTES=5

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Admin bootstrap credentials (used by npm run seed)
ADMIN_PHONE=03000000000
ADMIN_PASSWORD=Admin@123

# Wallet rules (Admin-configurable in DB too)
COMMISSION_PERCENT=10
AUTO_RELEASE_HOURS=24
MIN_ADVANCE_BOOKING_HOURS=2
MAX_ADVANCE_BOOKING_DAYS=30
CUSTOMER_CANCEL_REFUND_PERCENT=85
PRO_CANCEL_PENALTY_PERCENT=10
