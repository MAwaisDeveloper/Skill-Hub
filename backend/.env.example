# Hunar Backend - Environment
# Copy this file to .env and fill values

# Server
PORT=4000
NODE_ENV=development

# MySQL - local dev ke liye localhost; LIVE hosting ke liye free MySQL host:
# Clever Cloud (dev plan), Aiven free, or freesqldatabase.com - host/user/pass yahan dalein
# (Vercel project env vars mein bhi yehi values DB_HOST/DB_USER/DB_PASSWORD/DB_NAME ke sath dalein)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hunar

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# OTP (dev mode prints OTP to console; integrate SMS gateway in production)
OTP_SECRET=change-this-otp-pepper
OTP_EXPIRY_MINUTES=5

# Frontend URL (CORS) - local: http://localhost:5173 ; live: https://skillhub.vercel.app
CLIENT_URL=http://localhost:5173

# LIVE (Vercel + hosted Node API) ke liye extra env vars (Vercel dashboard > Settings > Environment Variables):
# CLIENT_URL=https://skillhub.vercel.app
# API_BASE=https://<your-node-api-host>   (agar alag Node host use ho; Vercel par api/index.js khud API chalata hai)
# MIRROR_DB=1                             (sirf tab jab PHP bridge mode ho)

# Admin bootstrap credentials (used by npm run seed)
ADMIN_PHONE=03000000000
ADMIN_PASSWORD=Admin@123

# Wallet rules (Admin-configurable in DB too)
COMMISSION_PERCENT=10
AUTO_RELEASE_HOURS=24
MIN_ADVANCE_BOOKING_HOURS=2
MAX_ADVANCE_BOOKING_DAYS=30
CUSTOMER_CANCEL_REFUND_PERCENT=85
PRO_CANCEL_PENALTY_PERCENT=10
